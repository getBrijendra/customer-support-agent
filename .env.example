# ---------------------------------------------------------------------------
# Local development — talks to the Supabase CLI stack (`make db-up`).
# Copy to .env and fill in GOOGLE_API_KEY, API keys and SECRETS_ENCRYPTION_KEY. Never commit .env.
# ---------------------------------------------------------------------------
APP_ENV=local

# Database: take the DB URL from `supabase status` and switch the scheme to postgresql+asyncpg://
# (this repo's supabase/config.toml uses port 55422 so it can run beside other local Supabase projects)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55422/postgres
# Separate database on the same local Supabase instance, used ONLY by the integration tests.
# Its name must end in _test (the test harness drops and recreates it).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55422/support_assistant_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Gemini (Google AI Studio key). Model names are configuration, not code.
LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-pro-preview
COMPILER_MODEL=gemini-3.1-pro-preview
ROUTER_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=gemini-embedding-2
# Fixed by the migration (vector(768)). Changing it needs a new migration + re-embedding.
EMBEDDING_DIMENSIONS=768

# Search & routing (pgvector + Postgres full-text in the same database)
TEXT_SEARCH_CONFIG=english
HNSW_EF_SEARCH=100
ROUTING_CANDIDATES=20
ROUTING_MAX_INTENTS=3
ROUTING_MIN_SCORE=0.3
REFERENCE_TOP_K=5
FALLBACK_SECTION_TOP_K=4

# Ingestion & compilation
MAX_UPLOAD_BYTES=2000000
INGESTION_SYNC=false
SUPPORTED_GUIDELINE_FORMATS=txt
COMPILE_SINGLE_PASS_MAX_CHARS=30000
INTENT_INDEX_EXAMPLES=8
INTENT_EVAL_EXAMPLES=3
AUTO_APPROVE_GUIDELINES=true
AUTO_APPROVE_MIN_ROUTING_TOP1=0.8

# Original-file storage: the exact uploaded bytes go to a private Supabase Storage bucket
# (created at startup). `none` keeps only the decoded text in Postgres.
# SUPABASE_URL is the API URL and SUPABASE_SERVICE_ROLE_KEY the "Secret" (sb_secret_...) or
# legacy service_role key, both from `supabase status`. Server-side only: never ship this key.
GUIDELINE_STORAGE_BACKEND=supabase
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
GUIDELINE_STORAGE_BUCKET=guideline-files
STORAGE_TIMEOUT_SECONDS=30

# Tools / company integrations
TOOLS_ENABLED=true
AGENT_MAX_STEPS=4
TOOL_TIMEOUT_SECONDS=10
AGENT_TOTAL_TIMEOUT_SECONDS=30
TOOL_RESULT_MAX_CHARS=4000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Local MCP / HTTP / DB endpoints usually live on localhost; set false in production (SSRF guard).
OUTBOUND_ALLOW_PRIVATE_NETWORK=true
SQL_ADAPTER_ROW_LIMIT=50
SQL_ADAPTER_TIMEOUT_SECONDS=5

# Optional LangSmith tracing. OFF by default: when enabled, customer messages and tool data are
# sent to LangSmith (a third party). Only enable for debugging with non-sensitive data.
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer_service_agent

# Optional Sentry (off unless SENTRY_DSN is set). ERROR+ log records become issues, INFO+ become
# breadcrumbs. PII, request bodies and local variables are never sent; API-key headers are scrubbed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_LOG_EVENT_LEVEL=ERROR
SENTRY_LOG_BREADCRUMB_LEVEL=INFO
# Also send log records (>= SENTRY_LOGS_LEVEL) to Sentry Logs
SENTRY_ENABLE_LOGS=false
SENTRY_LOGS_LEVEL=INFO

# Auth: comma-separated keys. Optional "label:key" form; the label is stored as uploaded_by.
AGENT_API_KEYS=agent:change-me-agent-key
ADMIN_API_KEYS=admin:change-me-admin-key

# Rate limiting for POST /chats ("limits" notation; ";" for several windows; empty disables a level).
# memory:// is per process. Use redis://host:6379/0 (or rediss://) when running several processes.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_STRATEGY=sliding-window-counter
CHAT_RATE_LIMIT_PER_AGENT=20/minute
CHAT_RATE_LIMIT_PER_COMPANY=300/minute
RATE_LIMIT_FAIL_OPEN=true

LOG_LEVEL=INFO
# Per-process cache of slug -> active version, rules and live bindings (seconds; 0 disables)
COMPANY_CACHE_TTL_SECONDS=30
