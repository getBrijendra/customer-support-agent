# ---------------------------------------------------------------------------
# Production — hosted Supabase. Only DATABASE_URL and secrets differ from local.
# Use the DIRECT connection or the SESSION pooler (port 5432) for the API process.
# The TRANSACTION pooler (port 6543) works too, but the app then disables asyncpg
# prepared statements and its own pooling automatically (see README).
# The pgvector extension must be available (it is on Supabase); the migration enables it.
# ---------------------------------------------------------------------------
APP_ENV=prod

DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

LLM_PROVIDER=google
GOOGLE_API_KEY=<secret>
LLM_MODEL=gemini-3.1-pro-preview
COMPILER_MODEL=gemini-3.1-pro-preview
ROUTER_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

TEXT_SEARCH_CONFIG=english
HNSW_EF_SEARCH=100
ROUTING_CANDIDATES=20
ROUTING_MAX_INTENTS=3
ROUTING_MIN_SCORE=0.3
REFERENCE_TOP_K=5
FALLBACK_SECTION_TOP_K=4

MAX_UPLOAD_BYTES=2000000
INGESTION_SYNC=false
SUPPORTED_GUIDELINE_FORMATS=txt
COMPILE_SINGLE_PASS_MAX_CHARS=30000
INTENT_INDEX_EXAMPLES=8
INTENT_EVAL_EXAMPLES=3
AUTO_APPROVE_GUIDELINES=true
AUTO_APPROVE_MIN_ROUTING_TOP1=0.8

GUIDELINE_STORAGE_BACKEND=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_ key from Project Settings -> API Keys>
GUIDELINE_STORAGE_BUCKET=guideline-files
STORAGE_TIMEOUT_SECONDS=30

TOOLS_ENABLED=true
AGENT_MAX_STEPS=4
TOOL_TIMEOUT_SECONDS=10
AGENT_TOTAL_TIMEOUT_SECONDS=30
TOOL_RESULT_MAX_CHARS=4000
SECRETS_ENCRYPTION_KEY=<fernet-key>
OUTBOUND_ALLOW_PRIVATE_NETWORK=false
SQL_ADAPTER_ROW_LIMIT=50
SQL_ADAPTER_TIMEOUT_SECONDS=5

LANGSMITH_TRACING=false

SENTRY_DSN=<sentry-dsn>
SENTRY_ENVIRONMENT=prod
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_LOG_EVENT_LEVEL=ERROR
SENTRY_LOG_BREADCRUMB_LEVEL=INFO
SENTRY_ENABLE_LOGS=true
SENTRY_LOGS_LEVEL=WARNING

AGENT_API_KEYS=<label>:<long-random-key>
ADMIN_API_KEYS=<label>:<long-random-key>

LOG_LEVEL=INFO
COMPANY_CACHE_TTL_SECONDS=30
